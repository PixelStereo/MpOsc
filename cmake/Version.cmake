# Published tag builds identify releases; local builds always carry a revision.
# Ordinary builds identify the preceding release and the exact source commit.
set(_mposc_root "${CMAKE_CURRENT_LIST_DIR}/..")
set(_mposc_release FALSE)
if("$ENV{GITHUB_REF_TYPE}" STREQUAL "tag" OR MPOSC_RELEASE_BUILD)
  set(_mposc_release TRUE)
endif()
if(DEFINED MPOSC_VERSION AND NOT MPOSC_VERSION STREQUAL "")
  set(MPOSC_BASE_VERSION "${MPOSC_VERSION}")
elseif("$ENV{GITHUB_REF_TYPE}" STREQUAL "tag")
  set(MPOSC_BASE_VERSION "$ENV{GITHUB_REF_NAME}")
else()
  execute_process(COMMAND git describe --tags --abbrev=0 --match "v[0-9]*" --match "[0-9]*" HEAD
    WORKING_DIRECTORY "${_mposc_root}" OUTPUT_VARIABLE MPOSC_BASE_VERSION
    OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
  if(MPOSC_BASE_VERSION STREQUAL "")
    file(STRINGS "${_mposc_root}/VERSION" MPOSC_BASE_VERSION LIMIT_COUNT 1)
  endif()
endif()
string(REGEX REPLACE "^v" "" MPOSC_BASE_VERSION "${MPOSC_BASE_VERSION}")
if(NOT MPOSC_BASE_VERSION MATCHES "^([0-9]+)[.]([0-9]+)([.]([0-9]+))?([-+][0-9A-Za-z.-]+)?$")
  message(FATAL_ERROR "Invalid release version: ${MPOSC_BASE_VERSION}")
endif()
set(MPOSC_VERSION_NUMERIC "${CMAKE_MATCH_1}.${CMAKE_MATCH_2}")
if("${CMAKE_MATCH_4}" STREQUAL "")
  string(APPEND MPOSC_VERSION_NUMERIC ".0")
else()
  string(APPEND MPOSC_VERSION_NUMERIC ".${CMAKE_MATCH_4}")
endif()
set(MPOSC_VERSION "${MPOSC_BASE_VERSION}")
if(NOT _mposc_release)
  execute_process(COMMAND git rev-parse --short=8 HEAD WORKING_DIRECTORY "${_mposc_root}"
    OUTPUT_VARIABLE _mposc_commit OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
  if(NOT _mposc_commit MATCHES "^[0-9a-f]+$")
    set(_mposc_commit "unknown") # source archive without Git metadata
  endif()
  string(APPEND MPOSC_VERSION "_${_mposc_commit}")
endif()
set(MPOSC_APP_NAME "MpOsc ${MPOSC_VERSION}")
# Reconfigure incremental builds after a checkout or commit, including worktrees.
if(NOT CMAKE_SCRIPT_MODE_FILE)
  execute_process(COMMAND git symbolic-ref -q HEAD WORKING_DIRECTORY "${_mposc_root}"
    OUTPUT_VARIABLE _mposc_ref OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
  foreach(_ref HEAD "${_mposc_ref}" packed-refs)
    if(NOT _ref STREQUAL "")
      execute_process(COMMAND git rev-parse --path-format=absolute --git-path "${_ref}"
        WORKING_DIRECTORY "${_mposc_root}" OUTPUT_VARIABLE _path OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
      if(EXISTS "${_path}")
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_path}")
      endif()
    endif()
  endforeach()
endif()
message(STATUS "Application: ${MPOSC_APP_NAME}")
