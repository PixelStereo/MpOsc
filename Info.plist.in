<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>CFBundleExecutable</key><string>${MACOSX_BUNDLE_EXECUTABLE_NAME}</string>
<key>CFBundleIdentifier</key><string>com.pixelstereo.mp-osc</string>
<key>CFBundleIconFile</key><string>MpOsc.icns</string>
<key>CFBundleName</key><string>MpOsc</string>
<key>CFBundleDisplayName</key><string>@MPOSC_APP_NAME@</string>
<key>CFBundleVersion</key><string>@PROJECT_VERSION@</string>
<key>CFBundlePackageType</key><string>APPL</string>
<key>CFBundleShortVersionString</key><string>@PROJECT_VERSION@</string>
<key>NSCameraUsageDescription</key><string>MpOsc analyzes camera frames locally to produce OSC signals.</string>
</dict></plist>
